# ============================================================
# Instructions
# ============================================================
# This file is required. Copy it to .env, generate unique secrets, and do not
# commit .env. Database and initial-admin values apply only on first setup.

# ============================================================
# Required settings
# ============================================================
DIGITAL_TWIN_DB_PASSWORD=
DIGITAL_TWIN_SECRET_KEY=
DIGITAL_TWIN_ADMIN_PASSWORD=

# ============================================================
# Optional settings
# ============================================================
DIGITAL_TWIN_DB_USER=digital_twin
DIGITAL_TWIN_DB_NAME=digital_twin
DIGITAL_TWIN_ADMIN_USER=admin
DIGITAL_TWIN_ACCESS_TOKEN_MINUTES=30

DIGITAL_TWIN_BIND_ADDRESS=127.0.0.1
DIGITAL_TWIN_PORT=3000

# Keep "database" for Docker-managed storage, or use an absolute host path.
DIGITAL_TWIN_DB_SOURCE=database
