# ============================================================
# Instructions
# ============================================================
# This file is required. Copy it to .env, replace every empty required value,
# and do not commit .env.

# ============================================================
# Required settings
# ============================================================
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=

# ============================================================
# Optional settings
# ============================================================
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1

NEXTCLOUD_BIND_ADDRESS=127.0.0.1
NEXTCLOUD_PORT=8080
NEXTCLOUD_PHP_MEMORY_LIMIT=512M
NEXTCLOUD_UPLOAD_LIMIT=1G
NEXTCLOUD_APACHE_BODY_LIMIT=1073741824

# Keep these names for Docker-managed storage, or use absolute host paths.
NEXTCLOUD_DB_SOURCE=database
NEXTCLOUD_DATA_SOURCE=nextcloud

# Used only by extensions/compose.reverse-proxy.yaml.
SHARED_NETWORK_NAME=stacklab-shared
# NEXTCLOUD_PUBLIC_HOST=cloud.example.com
# NEXTCLOUD_PUBLIC_URL=https://cloud.example.com
# NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
