# -----------------------------------------------------------------------------
# Instructions
# -----------------------------------------------------------------------------

# Copy this file to .env only when changing the defaults.
# Never commit .env. Values are passed explicitly by compose.yaml.

# -----------------------------------------------------------------------------
# Optional settings
# -----------------------------------------------------------------------------

# Browser ports and host interface.
# APPSMITH_BIND_ADDRESS=127.0.0.1
# APPSMITH_HTTP_PORT=8080
# APPSMITH_HTTPS_PORT=8443

# Leave this commented to use a Docker-managed named volume.
# To use a host directory, enter an absolute Linux path outside this repository.
# Changing the source does not move existing data and can change permissions.
# Read the Your data section in README.md before changing this value.
# APPSMITH_STACKS_SOURCE=
