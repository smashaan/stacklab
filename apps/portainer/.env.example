# Portainer is usable without a .env file. Copy this file only to override
# the safe defaults below.

# Keep the management UI on localhost. For remote use, prefer an SSH tunnel.
PORTAINER_BIND_ADDRESS=127.0.0.1
PORTAINER_HTTPS_PORT=9443

# Keep "data" for Docker-managed storage, or use an absolute host path.
PORTAINER_DATA_SOURCE=data
