# Optional. The defaults work without this file.
HOME_ASSISTANT_TIME_ZONE=Etc/UTC

# Keep "config" for Docker-managed storage, or use an absolute host path.
HOME_ASSISTANT_CONFIG_SOURCE=config

# Required only by extensions/compose.device.yaml.
# Prefer a stable /dev/serial/by-id/... path over /dev/ttyUSB0.
# HOME_ASSISTANT_DEVICE=/dev/serial/by-id/replace-me
