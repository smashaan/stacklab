# ============================================================
# Instructions
# ============================================================
# This file is required. Copy it to .env, generate the secret and password
# hash as described in README.md, and do not commit .env.

# ============================================================
# Required settings
# ============================================================
NODE_RED_CREDENTIAL_SECRET=
NODE_RED_ADMIN_USER=
# Enclose the bcrypt hash in single quotes so dollar signs remain literal.
NODE_RED_ADMIN_PASSWORD_HASH=

# ============================================================
# Optional settings
# ============================================================
NODE_RED_TIME_ZONE=Etc/UTC
NODE_RED_BIND_ADDRESS=127.0.0.1
NODE_RED_PORT=1880
NODE_RED_NODE_OPTIONS=--max-old-space-size=512
NODE_RED_ENABLE_PROJECTS=false

# Keep "data" for Docker-managed storage, or use an absolute host path.
NODE_RED_DATA_SOURCE=data

# Used only by extensions/compose.shared-network.yaml.
SHARED_NETWORK_NAME=stacklab-shared
