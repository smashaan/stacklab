# ============================================================
# Instructions
# ============================================================
# This file is required. Copy it to .env, generate the dashboard credential,
# and do not commit .env.

# ============================================================
# Required settings
# ============================================================
# Generate this value as described in README.md. Keep the complete value in
# single quotes so the bcrypt dollar signs remain literal.
TRAEFIK_DASHBOARD_AUTH=

# ============================================================
# Optional settings
# ============================================================
TRAEFIK_DASHBOARD_HOST=traefik.localhost
TRAEFIK_BIND_ADDRESS=127.0.0.1
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_PROXY_NETWORK=stacklab-proxy

# Required only by extensions/compose.letsencrypt.yaml.
# TRAEFIK_ACME_EMAIL=admin@example.com
# TRAEFIK_CERTIFICATES_SOURCE=certificates
