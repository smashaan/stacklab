# ============================================================
# Instructions
# ============================================================
# This file is optional. Copy it to .env only to change defaults.
# Do not commit .env.

# ============================================================
# Optional settings
# ============================================================
# Use an absolute path for a workspace outside this app directory.
LATEX_WORKSPACE_SOURCE=./workspace

# Match the Linux host account that should own generated files.
LATEX_USER_ID=1000
LATEX_GROUP_ID=1000
