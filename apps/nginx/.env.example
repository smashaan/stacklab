# -----------------------------------------------------------------------------
# Instructions
# -----------------------------------------------------------------------------

# Copy this file to .env only when changing the defaults.
# Never commit .env. Values are passed explicitly by compose.yaml.

# -----------------------------------------------------------------------------
# Optional settings
# -----------------------------------------------------------------------------

# NGINX_BIND_ADDRESS=127.0.0.1
# NGINX_HTTP_PORT=8080

# Keep ./html for the tracked example site, or use an absolute host directory.
# NGINX_CONTENT_SOURCE=./html

# Used only by extensions/compose.proxy-network.yaml.
# NGINX_PROXY_NETWORK=stacklab-proxy
