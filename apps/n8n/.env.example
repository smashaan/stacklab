# ============================================================
# Instructions
# ============================================================
# This file is required. Copy it to .env, generate the encryption key as
# described in README.md, and do not commit .env.

# ============================================================
# Required settings
# ============================================================
N8N_ENCRYPTION_KEY=

# ============================================================
# Optional settings
# ============================================================
N8N_TIME_ZONE=Etc/UTC
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678

# Keep these names for Docker-managed storage, or use absolute host paths.
N8N_DATA_SOURCE=data
N8N_FILES_SOURCE=files

# Used only by extensions.
SHARED_NETWORK_NAME=stacklab-shared
# N8N_PUBLIC_HOST=n8n.example.com
# N8N_PUBLIC_URL=https://n8n.example.com/
# N8N_PROXY_HOPS=1
