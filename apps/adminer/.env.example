# -----------------------------------------------------------------------------
# Instructions
# -----------------------------------------------------------------------------

# Copy this file to .env only when changing the defaults.
# Never commit .env. Values are passed explicitly by compose.yaml.

# -----------------------------------------------------------------------------
# Optional settings
# -----------------------------------------------------------------------------

# ADMINER_BIND_ADDRESS=127.0.0.1
# ADMINER_PORT=8080

# Enable cross-app container networking.
# Create the network first with: docker network create stacklab
# STACKLAB_NETWORK=stacklab
