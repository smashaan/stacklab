# ============================================================
# Instructions
# ============================================================
# This file is required. Copy it to .env, set the password, and do not commit
# .env. The initial values apply only when PostgreSQL creates empty storage.

# ============================================================
# Required settings
# ============================================================
POSTGRES_PASSWORD=

# ============================================================
# Optional settings
# ============================================================
POSTGRES_USER=stacklab
POSTGRES_DB=stacklab
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Keep "data" for Docker-managed storage, or use an absolute host path.
POSTGRES_DATA_SOURCE=data

# Used only by extensions/compose.shared-network.yaml.
STACKLAB_NETWORK=stacklab
