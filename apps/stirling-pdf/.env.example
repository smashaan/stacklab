# -----------------------------------------------------------------------------
# Instructions
# -----------------------------------------------------------------------------

# Copy this file to .env only when changing the defaults.
# Never commit .env. Values are passed explicitly by compose.yaml.

# -----------------------------------------------------------------------------
# Optional settings
# -----------------------------------------------------------------------------

# Browser port. Change this if another application already uses 8080.
# STIRLING_PDF_PORT=8080

# Default: access from this computer only.
# After securing the admin account, use your server's LAN IP for LAN access.
# 0.0.0.0 publishes on all IPv4 interfaces, including public interfaces.
# STIRLING_PDF_BIND_ADDRESS=127.0.0.1

# Default interface language.
# STIRLING_PDF_LOCALE=en-GB

# Leave these lines commented to use Docker-managed named volumes.
# To use a host directory, uncomment only the paths you want to change and enter
# an absolute Linux host path after =. Absolute Linux paths begin with /.
# Changing a source does not move existing data. A new source starts empty and
# may need different permissions and backup steps.
# Read the Your data section in README.md before changing these values.
# STIRLING_PDF_CONFIGS_SOURCE=
# STIRLING_PDF_LOGS_SOURCE=
# STIRLING_PDF_CUSTOM_FILES_SOURCE=
# STIRLING_PDF_PIPELINE_SOURCE=
# STIRLING_PDF_STORAGE_SOURCE=
# STIRLING_PDF_TESSDATA_SOURCE=
